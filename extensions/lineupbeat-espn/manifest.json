{
  "manifest_version": 3,
  "name": "Lineup Beat ESPN My Team (Development)",
  "version": "0.1.1",
  "description": "Captures the visible ESPN fantasy roster locally and shares it only with Lineup Beat development.",
  "permissions": ["storage"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/football/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://lineupbeat-dev.pages.dev/my-team/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
