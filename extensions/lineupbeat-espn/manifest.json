{
  "manifest_version": 3,
  "name": "Lineup Beat ESPN Connector BETA",
  "version": "0.3.0",
  "description": "THIS EXTENSION IS FOR BETA TESTING. Saves ESPN roster and league-history data locally for Lineup Beat.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://lm-api-reads.fantasy.espn.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://fantasy.espn.com/football/*"],
      "js": ["espn-roster-parser.js", "espn-history-parser.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://lineupbeat-dev.pages.dev/my-team/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://lineupbeat-dev.pages.dev/league-history/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
